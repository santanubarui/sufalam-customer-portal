# Template for local secrets — never commit the filled-in copies (*.local is gitignored).
# Escape every $ in values as \$.
#
#   development:  copy to .env.development.local   (npm run dev, npm run test:api)
#   production:   copy to .env.production.local    (npm run serve) — or set these as real environment variables

# ── SAP Service Layer service user (used by the portal backend only, never sent to the browser) ──
# Create a dedicated SAP user with access to: Business Partners, Items, Sales Orders, Drafts, A/R Invoices,
# Down Payments, Credit Memos, Incoming Payments, Deliveries (update), Attachments. Do NOT use `manager`.
SAP_SERVICE_USER=
SAP_SERVICE_PASSWORD=
# SAP_COMPANY_DB=TEST_280726
# SAP_SL_ORIGIN=https://sufalam.connectcloud365.com:57138
# SAP_TLS_INSECURE=true          # accept SL's internal certificate (default true)

# ── Portal sessions ──
# Required in production: at least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SESSION_SECRET=
# PORTAL_SESSION_MINUTES=30
# Customer (CardCode) opened when signing in with an SAP user ID such as manager (dev default: VITE_DEV_CARD_CODE).
# Leave empty to allow email sign-in only.
# PORTAL_STAFF_CARD_CODE=
# PORTAL_PUBLIC_URL=https://portal.sufalam.example   # used in email links
# PORTAL_DATA_DIR=server-data                        # portal accounts (users.json) — back this up
# COOKIE_SECURE=true                                 # default true in production (needs HTTPS)
# TRUST_PROXY=true                                   # set when behind nginx / IIS (uses X-Forwarded-For)
# PORT=8080

# ── Email (OTP codes, registration notices). Without SMTP_HOST mails are only printed to the console. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sufalam Customer Portal <portal@sufalam.example>
REGISTRATION_NOTIFY_EMAIL=

# ── Development only ──
# In `npm run dev` the old dev SAP login is used as the service user when SAP_SERVICE_USER is empty.
VITE_DEV_SAP_USER=
VITE_DEV_SAP_PASSWORD=
# customer used by `npm run test:api`
VITE_DEV_CARD_CODE=
