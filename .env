# ── Shared settings (all modes). No secrets here — this file is committed. ──

# SAP Business One Service Layer origin.
# Used only by the Vite dev/preview proxy (server side) — never sent to the browser.
SAP_SL_ORIGIN=https://sufalam.connectcloud365.com:57138

# DTS Sufalam API (forgot password / OTP check / update password / change password). Server side only.
# Endpoint list: https://sap.sufalamindustries.com:22401/Help
SUFALAM_API_URL=https://sap.sufalamindustries.com:22401

# Path the browser calls; the proxy forwards /b1s/* to SAP_SL_ORIGIN. v2 = OData v4.
VITE_SAP_BASE_URL=/b1s/v2

# Company database pre-filled on the sign-in screen.
VITE_SAP_COMPANY_DB=TEST_280726
